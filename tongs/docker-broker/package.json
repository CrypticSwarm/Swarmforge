{
  "name": "swarmforge-docker-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Swarmforge broker tong: exposes a configured set of narrow docker-task verbs as an HTTP MCP server.",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
