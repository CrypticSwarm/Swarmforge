#!/usr/bin/env python3
"""Entry point for the `swarmforge` command (`clone`/`init`).

Swarmforge runs out of a checkout rather than an installed package, so nothing
has put the repo root on the import path yet. This shim prepends it -- ahead of
any copy that happens to be installed on the host -- and hands off to
`swarmforge.cli`. Resolving that path is the whole job: no command logic lives
here, and no module under `swarmforge/` needs to know where it sits on disk.
"""

import os
import sys

# realpath, not abspath: a shim symlinked onto PATH must resolve to its own checkout.
_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if _REPO_ROOT not in sys.path:
    sys.path.insert(0, _REPO_ROOT)

from swarmforge.cli import main  # noqa: E402  (needs the path above)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
